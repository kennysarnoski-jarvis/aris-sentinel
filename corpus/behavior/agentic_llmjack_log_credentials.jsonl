{"t": 0, "payload": "ls -la /var/log/nginx /var/log/app"}
{"t": 8, "payload": "zgrep -hoE 'AKIA[0-9A-Z]{16}' /var/log/nginx/access.log*"}
{"t": 16, "payload": "grep -rhoiE '(x-api-key|authorization: bearer|token=)[^& \"]+' /var/log/app | sort -u | head -50"}
{"t": 24, "payload": "grep -rn 'amazonaws.com\\|googleapis.com\\|azure.com' /var/log/app/*.log | head"}
{"t": 32, "payload": "tr '\\0' '\\n' < /proc/self/environ | grep -iE 'KEY|TOKEN|SECRET'"}
