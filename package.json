{
  "name": "aris-sentinel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Runtime defense agent that detects agentic AI attackers by their self-narration signature.",
  "scripts": {
    "test": "bun run test/runCorpus.ts",
    "test:unit": "bun test",
    "typecheck": "tsc --noEmit",
    "test:all": "bun run test && bun run windows && bun run pipeline:stub && bun test && node agent/sentinel-agent.mjs --selftest && npm run win:mock",
    "corpus:snapshot": "bun run test/corpusSnapshot.ts --update",
    "generalize": "bun run test/generalization.ts",
    "tier2:smoke": "bun run test/tier2.ts --smoke",
    "tier2": "bun run test/tier2.ts",
    "pipeline:stub": "bun run test/pipeline.ts --stub",
    "pipeline": "bun run test/pipeline.ts",
    "fpRate": "bun run test/fpRate.ts",
    "matrix": "bun run test/adjudicatorMatrix.ts",
    "windows": "bun run test/windows.ts",
    "win:mock": "node agent/win/sentinel-agent-win.mjs --mock",
    "selftest": "node agent/sentinel-agent.mjs --selftest"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "SEE LICENSE IN LICENSE"
}
